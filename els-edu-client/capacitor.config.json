{
  "appId": "com.emeelan.elsedu",
  "appName": "ELS Edu",
  "webDir": "dist",
  "server": {
    "allowNavigation": [
      "emeelan.com"
    ]
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#ffffff",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": true,
      "launchShowDuration": 1000
    },
    "Keyboard": {
      "resize": "body",
      "style": "ios",
      "resizeOnFullScreen": true
    }
  },
  "android": {
    "allowMixedContent": true,
    "scheme": "elsedu",
    "hostname": "emeelan.com"
  },
  "ios": {
    "scheme": "elsedu",
    "contentInset": "always",
    "associatedDomains": [
      "applinks:emeelan.com"
    ]
  }
}